{{!< default}}

{{#post}}
<article class="{{post_class}} post">

    <header class="post-head">
        <aside class="margin-col">
            <time class="note" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            <span class="note note-dim">{{reading_time minute="1 min read" minutes="% min read"}}</span>
            {{#foreach tags visibility="public"}}
                <a class="note note-link" href="{{url}}">{{name}}</a>
            {{/foreach}}
        </aside>
        <div class="post-head-main">
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="post-subtitle">{{custom_excerpt}}</p>
            {{/if}}
            <p class="post-byline">
                {{#foreach authors}}
                    <a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}
                {{/foreach}}
            </p>
        </div>
    </header>

    {{#if feature_image}}
    <figure class="post-feature">
        <img
            srcset="{{img_url feature_image size="m"}} 640w,
                    {{img_url feature_image size="l"}} 1024w,
                    {{img_url feature_image size="xl"}} 1600w"
            sizes="(max-width: 1100px) 100vw, 1080px"
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        >
        {{#if feature_image_caption}}
            <figcaption>{{{feature_image_caption}}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <section class="gh-content gh-canvas">
        {{content}}
    </section>

    <footer class="post-foot">
        {{#if @site.members_enabled}}
            {{#unless @member}}
            <aside class="cta">
                <h3 class="cta-title">Read this in your inbox</h3>
                <p class="cta-text">New essays from {{@site.title}}, delivered as they're published. No noise in between.</p>
                <a class="btn btn-subscribe" href="#/portal/signup">Subscribe</a>
            </aside>
            {{/unless}}
        {{/if}}

        {{#if comments}}
        <section class="post-comments">
            {{comments}}
        </section>
        {{/if}}
    </footer>

</article>
{{/post}}
