{{!< default}}

{{#author}}
<section class="masthead masthead-archive">
    <p class="note archive-kicker">Written by</p>
    <h1 class="masthead-title">{{name}}</h1>
    {{#if bio}}
        <p class="masthead-desc">{{bio}}</p>
    {{/if}}
</section>
{{/author}}

<section class="feed">
    {{#foreach posts}}
        {{> "post-card"}}
    {{/foreach}}
</section>

{{pagination}}
